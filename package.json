{
  "name": "@local/dsh-conversation-export",
  "version": "1.0.0",
  "private": true,
  "description": "Export a DeepSeek Harness conversation as JSON or Markdown from the sidebar session menu.",
  "license": "MIT",
  "type": "module",
  "engines": { "dsh": "0.2.1-rc.5" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "host-service.js", "export-core.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE", "tests/*.test.js"],
  "scripts": { "test": "node --test tests/*.test.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
